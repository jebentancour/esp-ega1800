# Copiá este archivo como `secrets.yaml` y completá tus datos.
# `secrets.yaml` está en .gitignore y NO debe subirse al repo.

wifi_ssid: "TU_WIFI"
wifi_password: "TU_CLAVE_WIFI"

# Clave de cifrado de la API de ESPHome (la usa Home Assistant para conectarse).
# Generá una de 32 bytes en base64:
#   - en https://esphome.io/components/api  (botón "Generate"), o
#   - en una terminal:  openssl rand -base64 32
api_encryption_key: "base64_de_32_bytes_aca="
